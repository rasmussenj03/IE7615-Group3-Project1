      "cell_type": "markdown",
      "source": [
        "**Training curves** (train = dashed, validation = solid; one colour per seed):"
      ],
      "metadata": {
        "id": "RkO-8-M4eeDV"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
        "colors = plt.rcParams[\"axes.prop_cycle\"].by_key()[\"color\"]\n",
        "for i, (seed, h) in enumerate(histories.items()):\n",
        "    for ax, metric in zip(axes, (\"loss\", \"acc\")):\n",
        "        ax.plot(h[\"epoch\"], h[f\"train_{metric}\"], \"--\", color=colors[i], alpha=0.7, label=f\"train (seed {seed})\")\n",
        "        ax.plot(h[\"epoch\"], h[f\"val_{metric}\"], \"-\", color=colors[i], label=f\"val (seed {seed})\")\n",
        "axes[0].set(title=\"Cross-entropy loss\", xlabel=\"Epoch\", ylabel=\"Loss\")\n",
        "axes[1].set(title=\"Accuracy\", xlabel=\"Epoch\", ylabel=\"Accuracy\", ylim=(0, 1.02))\n",
        "for ax in axes:\n",
        "    ax.grid(alpha=0.3)\n",
        "axes[1].legend(fontsize=8, loc=\"lower right\", ncol=2)\n",
        "fig.suptitle(DISPLAY_NAME)\n",
        "fig.tight_layout()\n",
        "fig.savefig(RESULTS_DIR / \"training_curves.png\", dpi=150, bbox_inches=\"tight\")"
      ],
      "metadata": {
        "colab": {
